{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "秘仪",
  "mainBinaryName": "秘仪",
  "version": "1.0.4",
  "identifier": "com.caohua.arcanum",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "秘仪",
        "width": 1180,
        "height": 780,
        "minWidth": 760,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:1421"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Gryphon",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "category": "Entertainment",
    "shortDescription": "Rider–Waite–Smith塔罗桌面游戏",
    "longDescription": "秘仪是一款本地优先的78张Rider–Waite–Smith塔罗桌面游戏。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "template": "nsis/installer.nsi",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": { "type": "offlineInstaller" }
    }
  }
}
